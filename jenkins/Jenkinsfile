pipeline {
    agent any

    environment {
        FRONTEND_HOST = '10.0.1.179'
        BACKEND_HOST  = '10.0.2.219'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/pip install -r backend/requirements-dev.txt
                    cd backend
                    ../.venv/bin/flake8
                    ../.venv/bin/pytest
                '''
            }
        }

        stage('Deploy Backend') {
            steps {
                sshagent(credentials: ['aws-3tier-key']) {
                    sh """
                        scp -o StrictHostKeyChecking=no backend/app.py ubuntu@${BACKEND_HOST}:/var/www/backend/app.py
                        ssh -o StrictHostKeyChecking=no ubuntu@${BACKEND_HOST} 'sudo systemctl restart backend'
                    """
                }
            }
        }

        stage('Deploy Frontend') {
            steps {
                sshagent(credentials: ['aws-3tier-key']) {
                    sh """
                        scp -o StrictHostKeyChecking=no frontend/app.py ubuntu@${FRONTEND_HOST}:/var/www/frontend/app.py
                        scp -o StrictHostKeyChecking=no -r frontend/templates ubuntu@${FRONTEND_HOST}:/var/www/frontend/
                        ssh -o StrictHostKeyChecking=no ubuntu@${FRONTEND_HOST} 'sudo systemctl restart frontend'
                    """
                }
            }
        }

        stage('Health Check') {
            steps {
                sshagent(credentials: ['aws-3tier-key']) {
                    sh """
                        sleep 10
                        for i in 1 2 3 4 5; do
                            code=\$(ssh -o StrictHostKeyChecking=no ubuntu@${BACKEND_HOST} 'curl -s -o /dev/null --max-time 5 -w "%{http_code}" http://127.0.0.1/inexistant') || true
                            echo "Backend: HTTP \$code (essai \$i)"
                            [ "\$code" = "200" ] && break
                            [ "\$i" = "5" ] && exit 1
                            sleep 5
                        done
                        for i in 1 2 3 4 5; do
                            code=\$(curl -s -o /dev/null --max-time 5 -w "%{http_code}" http://${FRONTEND_HOST}/) || true
                            echo "Frontend: HTTP \$code (essai \$i)"
                            [ "\$code" = "200" ] && break
                            [ "\$i" = "5" ] && exit 1
                            sleep 5
                        done
                    """
                }
            }
        }

    }

    post {
        success {
            echo 'Deployment successful!'
        }
        failure {
            echo 'Deployment failed.'
        }
    }
}
